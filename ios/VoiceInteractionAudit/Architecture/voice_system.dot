digraph VoiceSystem {
  graph [rankdir=LR, bgcolor="#ffffff", pad="0.28", nodesep="0.38", ranksep="0.68", fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", color="#a6b9cd", fillcolor="#f4f8fc", fontname="DejaVu Sans", fontsize=11, margin="0.17,0.10"];
  edge [color="#647a96", arrowsize=0.75, penwidth=1.25];
  person [label="User\non iPhone", fillcolor="#e4f2ff"];
  ui [label="SwiftUI\nVoice Surface"];
  audio [label="Native iOS Audio\nMic / Route / Echo"];
  policy [label="Voice Interaction Policy\nSwift - Tested", fillcolor="#e5f5ed"];
  exec [label="Serialized Effect Runner"];
  adapter [label="Replaceable Voice Adapter", fillcolor="#fff5df"];
  live [label="Full-Duplex\nRealtime or LiveKit"];
  chained [label="Chained\nSTT + Core + TTS"];
  core [label="Single Sovereign Core\nTask / Permission / Memory", fillcolor="#e4f2ff"];
  tool [label="Authorized Tools"];
  journal [label="Passive Evidence Log"];
  mac [label="Encrypted Export\nto Mac"];
  person -> ui; ui -> audio; audio -> policy; ui -> policy; policy -> exec;
  exec -> adapter; adapter -> live; adapter -> chained;
  exec -> core; core -> tool; core -> journal; journal -> mac;
  core -> ui [label="approval / receipt", fontsize=9];
  live -> exec [label="events", fontsize=9]; chained -> exec [label="events", fontsize=9];
}
